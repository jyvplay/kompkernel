+    topK: options.topK ?? 8000,
+    levels: options.levels ?? 6,
+    noAssign: options.noAssign ?? false,
+    allowPolyglot: options.allowPolyglot ?? false,
+    noSearch: options.noSearch ?? false,
+    noBlocks: options.noBlocks ?? false,
