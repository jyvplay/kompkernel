+        } else {
+          const i = Math.floor(rnd() * trial.length);
+          const j = Math.floor(rnd() * trial.length);
+          if (i === j) continue;
+          const t2 = trial[i]; trial[i] = trial[j]; trial[j] = t2;
+        }
