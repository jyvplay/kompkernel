+    const finalMap = mkMap(bestArr);
+    const wire = materialise(atoms, finalMap);
+    if (wire === null) continue;
+    if (wire.slice(1, wire.indexOf(CHIRON_SEP, 1)).includes(CHIRON_SEP)) continue;
