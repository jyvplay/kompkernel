i.github.com/users/legendecas/subscriptions","organizations_url":"https://api.github.com/users/legendecas/orgs","repos_url":"https://api.github.com/users/legendecas/repos","events_url":"https://api.github.com/users/legendecas/events{/privacy}","received_events_url":"https://api.github.com/users/legendecas/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4c234f6266aa6b2af4bdd392f5244f86a5a6a0c4","url":"https://api.github.com/repos/nodejs/node/commits/4c234f6266aa6b2af4bdd392f5244f86a5a6a0c4","html_url":"https://github.com/nodejs/node/commit/4c234f6266aa6b2af4bdd392f5244f86a5a6a0c4"}]},{"sha":"4c234f6266aa6b2af4bdd392f5244f86a5a6a0c4","node_id":"C_kwDOAZ7xs9oAKDRjMjM0ZjYyNjZhYTZiMmFmNGJkZDM5MmY1MjQ0Zjg2YTVhNmEwYzQ","commit":{"author":{"name":"Ulises Gascón","email":"ulisesgascongonzalez@gmail.com","date":"2026-10-31T17:25:28Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-31T17:25:28Z"},"message":"doc: remove CI lockdown steps from security releases\n\nThe CI is no longer locked down for security releases. The pre-release\nparagraph describing the lockdown procedure was already dropped from\nreleases.md in nodejs/node#64198, but the release day steps and two\ninline notes still told stewards and releasers to wait for it.\n\nRemove the remaining references:\n\n  * Drop 'Lock down the CI' and 'Unlock the CI' from the release day\n    checklist in security-release-process.md and renumber the steps.\n  * Drop the note in releases.md telling releasers not to run CI on\n    nodejs-private pull requests until the lockdown.\n  * Drop the security release details block under the CI step that\n    deferred to the lockdown coordinated with the Build Working Group.\n\nRefs: https://github.com/nodejs/node/pull/64198\nSigned-off-by: Ulises Gascon <ulisesgascongonzalez@gmail.com>\nPR-URL: https://github.com/nodejs/node/pull/67116\nRefs: https://github.com/nodejs/build/pull/4355\nReviewed-By: Richard Lau <richard.lau@ibm.com>\nReviewed-By: Antoine du Hamel <duhamelantoine1995@gmail.com>\nReviewed-By: Luigi Pinca <luigipinca@gmail.com>\nReviewed-By: Beth Griggs <bethanyngriggs@gmail.com>\nReviewed-By: Matteo Collina <matteo.collina@gmail.com>\nReviewed-By: Yagiz Nizipli <yagiz@nizipli.com>","tree":{"sha":"ab8884909b33ee4fa271c1ead79c5cb53bbfd6b8","url":"https://api.github.com/repos/nodejs/node/git/trees/ab8884909b33ee4fa271c1ead79c5cb53bbfd6b8"},"url":"https://api.github.com/repos/nodejs/node/git/commits/4c234f6266aa6b2af4bdd392f5244f86a5a6a0c4","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq5iSICRC1aQ7uu5UhlAAAN+wQADiCFnrfO8S+uHHsxvHfqlMX\nmS2bysZSByURsLUyibtHCWk8F7ZxLA6+dJ6lotMvLlEiTeskFBhrmryAddPqoMcH\ny3pafLKr9DlEHFaHPV8PCTGmfwZZt6xP7diEFsSoocheMdn6bzVO9RS3Fx+ncRlf\nuGUeJyj6RV+mHiFPnGTviBHyuZ3oWioxMemwVU040V0EiCvXiAQTjysSlBAtqQdt\n3mAcDVnDcta9aHpgbXl4UvM2Fsn3Z66Mla/rqJfZre2HISArV0RK73Ale6HKrF40\nHOYrPZKmZim/l8/v7fP8N0mqw+RwvramFCkr2Fb+nxAZc5vJwocKbj4rB7nOSdhr\nJjMz650MTOiqoGXAoUmhEHQDjD8KenUAg3NKRRFcYca8aGlp6yH1+NWsh+BNN1L7\nj0zuIWrniIesMkx1jHqzIRMXiHjNp58KvXR4J4ORB/gbx/980VAJGGRl7J7Qa1Aq\nWkE5lU1ArYIUE04zkqyFTl9G6xg06RRNvlm5/YXpedeuFRC/JT0mElDVV10yqoGG\nQt5UCppfllJF80H6t9ZSLIdpcUH1LQ5cqWvc4bumWpJhLJhe8cYJ1WDmcYq1qebC\n0/+FSsy6WHz25orOlZ7pi47KX7bpwcS3WhZpSWaeCaNleapr0E2OW5wNeG4amvOW\nQvpXW4zM5lSQcSeemlWJ\n=fCJ3\n-----END PGP SIGNATURE-----\n","payload":"tree ab8884909b33ee4fa271c1ead79c5cb53bbfd6b8\nparent 80a74e1813ddbb5b0bd507e1e09bc02790c452a2\nauthor Ulises Gascón <ulisesgascongonzalez@gmail.com> 1793467528 +0100\ncommitter GitHub <noreply@github.com> 1793467528 +0000\n\ndoc: remove CI lockdown steps from security releases\n\nThe CI is no longer locked down for security releases. The pre-release\nparagraph describing the lockdown procedure was already dropped from\nreleases.md in nodejs/node#64198, but the release day steps and two\ninline notes still told stewards and releasers to wait for it.\n\nRemove the remaining references:\n\n  * Drop 'Lock down the CI' and 'Unlock the CI' from the release day\n    checklist in security-release-process.md and renumber the steps.\n  * Drop the note in releases.md telling releasers not to run CI on\n    nodejs-private pull requests until the lockdown.\n  * Drop the security release details block under the CI step that\n    deferred to the lockdown coordinated with the Build Working Group.\n\nRefs: https://github.com/nodejs/node/pull/64198\nSigned-off-by: Ulises Gascon <ulisesgascongonzalez@gmail.com>\nPR-URL: https://github.com/nodejs/node/pull/67116\nRefs: https://github.com/nodejs/build/pull/4355\nReviewed-By: Richard Lau <richard.lau@ibm.com>\nReviewed-By: Antoine du Hamel <duhamelantoine1995@gmail.com>\nReviewed-By: Luigi Pinca <luigipinca@gmail.com>\nReviewed-By: Beth Griggs <bethanyngriggs@gmail.com>\nReviewed-By: Matteo Collina <matteo.collina@gmail.com>\nReviewed-By: Yagiz Nizipli <yagiz@nizipli.com>","verified_at":"2026-10-31T17:25:29Z"}},"url":"https://api.github.com/