 "transforms": [
  {
   "name": "case-fold",
   "rule": "all letters were lowercased; a bitmask restores case"
  },
  {
   "name": "space-after-punct",
   "rule": "a space follows every , ; : ! ?"
  },
  {
   "name": "space-before-punct-none",
   "rule": "no space precedes , . ; :"
  },
  {
   "name": "collapse-2space",
   "rule": "every run of 2+ spaces was one space"
  },
  {
   "name": "strip-trailing-ws",
   "rule": "no line ended in whitespace"
  },
  {
   "name": "tab-to-1space",
   "rule": "every tab was one space"
  },
  {
   "name": "eol-normalise",
   "rule": "the file ended with exactly one \\n"
  },
  {
   "name": "dbl-newline-to-par",
   "rule": "a blank line was the paragraph mark ¶"
  },
  {
   "name": "quote-strip-dq",
   "rule": "every \" was deleted"
  },
  {
   "name": "bracket-strip",
   "rule": "every ( ) [ ] { } was deleted"
  },
  {
   "name": "tree-draw-to-depth",
   "rule": "a leading depth digit replaces the tree drawing"
  },
  {
   "name": "indent-to-depth",
   "rule": "leading whitespace was 2 spaces per level"
  },
  {
   "name": "drop-decimal-trailing0",
   "rule": "a trailing .0 was dropped from every number"
  },
  {
   "name": "drop-leading-zeros",
   "rule": "leading zeros were dropped from every number"
  },
  {
   "name": "thousands-sep-strip",
   "rule": "every , inside a number was deleted"
  },
  {
   "name": "hex-lower",
   "rule": "hex letters were lowercased"
  },
  {
   "name": "uri-scheme-strip",
   "rule": "https:// was deleted"
  },
  {
   "name": "path-root-strip",
   "rule": "the longest constant path prefix was deleted"
  },
  {
   "name": "dup-line-run",
   "rule": "a repeated line was written once with a ×count"
  },
  {
   "name": "ascii-fold",
   "rule": "non-ASCII letters were folded to ASCII"
  }
