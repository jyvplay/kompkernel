[32m+[m
[32m+[m[32mexport interface PolysteliResult {[m
[32m+[m[32m  codec: 'polysteli';[m
[32m+[m[32m  applied: boolean;[m
[32m+[m[32m  message: string;[m
[32m+[m[32m  decoded: string;[m
[32m+[m[32m  exact: boolean;[m
[32m+[m[32m  messageTokens: number;[m
[32m+[m[32m  frontierTokens: number;[m
[32m+[m[32m  notes: string;[m
[32m+[m[32m  frontier?: TagstackResult;[m
[32m+[m[32m}[m
