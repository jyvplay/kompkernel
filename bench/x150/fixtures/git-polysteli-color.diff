[32m+[m[32mexport function polysteliRebuildRow(fields: string[], tail: string, widths: number[]): string | null {[m
[32m+[m[32m  let out = '';[m
[32m+[m[32m  for (let c = 0; c < widths.length; c++) {[m
[32m+[m[32m    const f = fields[c];[m
[32m+[m[32m    if (f === undefined || f.length > widths[c]!) return null;[m
[32m+[m[32m    out += ' '.repeat(widths[c]! - f.length) + f;[m
[32m+[m[32m  }[m
[32m+[m[32m  return out + tail;[m
[32m+[m[32m}[m
