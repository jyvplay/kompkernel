[32m+[m[32mfunction refuse(why: string, frontierTokens: number, notes?: string): PolysteliResult {[m
[32m+[m[32m  return { codec: 'polysteli', applied: false, message: '', decoded: '', exact: false,[m
[32m+[m[32m    messageTokens: frontierTokens, frontierTokens, notes: notes ?? why };[m
