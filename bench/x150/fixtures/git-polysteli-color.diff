[32m+[m[32m    // conforming stretches inside the block: rows whose first K fields sit on[m
[32m+[m[32m    // the block's uniform edges; other rows pass through untouched[m
[32m+[m[32m    let s = 0;[m
[32m+[m[32m    while (s < block.length) {[m
[32m+[m[32m      const probe = fitStretch(block.slice(s));[m
[32m+[m[32m      if (!probe) { out.push(block[s]!); s++; continue; }[m
[32m+[m[32m      if (probe.grid.rows.length >= MIN_ROWS) {[m
[32m+[m[32m        const marker = `${MARKER}${probe.grid.widths.join(',')}:${probe.grid.rows.length} rows single-spaced, pad field k to width k, rest verbatim.`;[m
[32m+[m[32m        if (polysteliParseMarker(marker) === null) throw new Error('ΠΟΛΥΣΤΗΛΗ: emitted marker does not parse');[m
[32m+[m[32m        markers.push(marker);[m
[32m+[m[32m        out.push(marker);[m
[32m+[m[32m        for (const [idx, f] of probe.grid.rows.entries()) {[m
[32m+[m[32m          const rebuilt = polysteliRebuildRow(f, probe.grid.tails[idx]!, probe.grid.widths);[m
[32m+[m[32m          if (rebuilt === null || rebuilt !== block[s + idx]!) throw new Error('ΠΟΛΥΣΤΗΛΗ: rebuild disagreement');[m
[32m+[m[32m          out.push(rebuilt);[m
[32m+[m[32m        }[m
[32m+[m[32m        changed = true;[m
[32m+[m[32m        s += probe.grid.rows.length;[m
[32m+[m[32m      } else { out.push(block[s]!); s++; }[m
[32m+[m[32m    }[m
[32m+[m[32m    i = j;[m
[32m+[m[32m  }[m
[32m+[m[32m  if (!changed) return null;[m
[32m+[m[32m  return { text: out.join('\n'), markers };[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mconst RE_MARKER =[m
[32m+[m[32m  /^(.)(\d+(?:,\d+)+):(\d+) rows single-spaced, pad field k to width k, rest verbatim\.$/;[m
[32m+[m
[32m+[m[32mexport function polysteliParseMarker(line: string): { marker: string; widths: number[]; rows: number } | null {[m
[32m+[m[32m  const m = RE_MARKER.exec(line);[m
[32m+[m[32m  if (!m) return null;[m
[32m+[m[32m  const widths = m[2]!.split(',').map(Number);[m
[32m+[m[32m  if (widths.some((w) => !Number.isInteger(w) || w <= 0)) return null;[m
[32m+[m[32m  if (Number(m[3]) < 1) return null;[m
[32m+[m[32m  return { marker: m[1]!, widths, rows: Number(m[3]) };[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/** Undo: markers name the exact rows that follow them; everything else is literal. */[m
[32m+[m[32mexport function polysteliUndo(text: string): string {[m
[32m+[m[32m  const lines = text.split('\n');[m
[32m+[m[32m  const out: string[] = [];[m
[32m+[m[32m  for (let i = 0; i < lines.length; i++) {[m
[32m+[m[32m    const mk = polysteliParseMarker(lines[i]!);[m
[32m+[m[32m    if (!mk || mk.marker !== MARKER) { out.push(lines[i]!); continue; }[m
[32m+[m[32m    if (i + mk.rows >= lines.length) throw new Error('ΠΟΛΥΣΤΗΛΗ: marker claims more rows than exist');[m
[32m+[m[32m    for (let r = 0; r < mk.rows; r++) {[m
[32m+[m[32m      const line = lines[i + 1 + r]!;[m
[32m+[m[32m      const re = /\S+/g;[m
[32m+[m[32m      let end = -1;[m
[32m+[m[32m      const fields: string[] = [];[m
[32m+[m[32m      for (let c = 0; c < mk.widths.length; c++) {[m
[32m+[m[32m        const m = re.exec(line);[m
[32m+[m[32m        if (!m) throw new Error('ΠΟΛΥΣΤΗΛΗ: row has fewer fields than the marker names');[m
[32m+[m[32m        fields.push(m[0]);[m
[32m+[m[32m        end = m.index + m[0].length;[m
[32m+[m[32m      }[m
[32m+[m[32m      const tail = line.slice(end);[m
[32m+[m[32m      const rebuilt = polysteliRebuildRow(fields, tail, mk.widths);[m
[32m+[m[32m      if (rebuilt === null) throw new Error('ΠΟΛΥΣΤΗΛΗ: field overflows its width');[m
[32m+[m[32m      out.push(rebuilt);[m
[32m+[m[32m    }[m
[32m+[m[32m    i += mk.rows;[m
[32m+[m[32m  }[m
[32m+[m[32m  return out.join('\n');[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/** True while a ΠΟΛΥΣΤΗΛΗ encode is inside its own parent-chain call. */[m
[32m+[m[32mlet IN_POLYSTELI = false;[m
[32m+[m
[32m+[m[32m/**[m
[32m+[m[32m * X149 DEFAULT-OFF, with a measured reason (not a stylistic choice): the arm's[m
[32m+[m[32m * inner parent-chain call runs even when G6 will refuse, and that extra wall[m
[32m+[m[32m * time shifts the outer chain's clock-bounded arms. Measured on kubectl:[m
[32m+[m[32m * default-on shipped 316 instead of 300 — ΣΤΟΙΧΗΔΟΝ/ΓΕΝΝΑΔΑΣ stopped landing[m
[32m+[m[32m * their improvements (bench/x149/receipts/frontier-polysteli*.jsonl, kept as[m
[32m+[m[32m * the fragility receipt). Same precedent as ΠΛΑΤΟΣ (X123, off by default so[m
[32m+[m[32m * the arm cannot rot). OMEGA_POLYSTELI=1 measures the real chain with the arm.[m
