[32m+[m[32m/**[m
[32m+[m[32m * Compose ΠΟΛΥΣΤΗΛΗ with the parent chain: transform, price by the parent,[m
[32m+[m[32m * undo, verify byte-exactness at every layer, admit only on strict gain.[m
[32m+[m[32m */[m
[32m+[m[32mexport function polysteliEncode([m
[32m+[m[32m  text: string,[m
[32m+[m[32m  enc: EncodingName = 'o200k_base',[m
[32m+[m[32m  options: { incumbent?: number; inner?: (t: string, e: EncodingName) => TagstackResult } = {},[m
[32m+[m[32m): PolysteliResult {[m
[32m+[m[32m  const innerFn = options.inner ?? ((t: string, e: EncodingName) => tagstackEncode(t, e));[m
[32m+[m[32m  let baseTokens = options.incumbent ?? 0;[m
[32m+[m[32m  if (options.incumbent === undefined) baseTokens = innerFn(text, enc).messageTokens;[m
[32m+[m[32m  if (polysteliDisabled()) return refuse('disabled (OMEGA_NO_POLYSTELI=1)', baseTokens);[m
[32m+[m[32m  if (IN_POLYSTELI) return refuse('re-entrancy guard', baseTokens);[m
[32m+[m[32m  if (!text.length || text.length > 400_000) return refuse('length out of range', baseTokens);[m
[32m+[m
[32m+[m[32m  let tr: ReturnType<typeof polysteliTransform> = null;[m
[32m+[m[32m  try { tr = polysteliTransform(text); } catch (e) { return refuse(`transform threw: ${String(e).slice(0, 80)}`, baseTokens); }[m
[32m+[m[32m  if (!tr) return refuse('no uniform-edge grid stretch with a tail', baseTokens);[m
[32m+[m
[32m+[m[32m  if (polysteliUndo(tr.text) !== text) return refuse('G3 own inverse disagrees', baseTokens);[m
[32m+[m
[32m+[m[32m  let inner: TagstackResult;[m
[32m+[m[32m  IN_POLYSTELI = true;[m
[32m+[m[32m  try { inner = innerFn(tr.text, enc); } catch { return refuse('parent chain threw', baseTokens); } finally { IN_POLYSTELI = false; }[m
[32m+[m[32m  if (inner.decoded !== tr.text) return refuse('G4 parent does not reproduce the rewritten text', baseTokens);[m
[32m+[m[32m  let decoded = '';[m
[32m+[m[32m  try { decoded = polysteliUndo(inner.decoded); } catch (e) { return refuse(`G5 undo threw on parent output: ${String(e).slice(0, 80)}`, baseTokens); }[m
[32m+[m[32m  if (decoded !== text) return refuse('G5 undo(parent output) !== source', baseTokens);[m
[32m+[m
[32m+[m[32m  const message = inner.message;[m
[32m+[m[32m  const messageTokens = countTokens(message, enc);[m
[32m+[m[32m  if (messageTokens >= baseTokens) {[m
[32m+[m[32m    return refuse(`G6 loses ${messageTokens} vs ${baseTokens}`, baseTokens,[m
[32m+[m[32m      `ΠΟΛΥΣΤΗΛΗ refused: M ${messageTokens} >= incumbent ${baseTokens}`);[m
[32m+[m[32m  }[m
[32m+[m[32m  return {[m
[32m+[m[32m    codec: 'polysteli', applied: true, message, decoded, exact: true,[m
[32m+[m[32m    messageTokens, frontierTokens: baseTokens,[m
[32m+[m[32m    notes: `ΠΟΛΥΣΤΗΛΗ ${tr.markers.length} grid(s); M ${baseTokens}->${messageTokens}`,[m
[32m+[m[32m    frontier: inner,[m
[32m+[m[32m  };[m
[32m+[m[32m}[m
