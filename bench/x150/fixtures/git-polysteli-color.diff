[32m+[m[32m/**[m
[32m+[m[32m * src/lib/omega/polysteli.ts — X149. ΠΟΛΥΣΤΗΛΗ (polysteli), "many columns".[m
[32m+[m[32m * =============================================================================[m
[32m+[m[32m *[m
[32m+[m[32m * RELATION TO ΣΤΉΛΗ (X124), AND WHY THIS IS A DIFFERENT MECHANISM[m
[32m+[m[32m * ---------------------------------------------------------------[m
[32m+[m[32m * ΣΤΉΛΗ fits ONE contiguous offset-sliced block and keeps the LAST FIELD to the[m
[32m+[m[32m * end of the line, so any row whose trailing column contains SPACES (an `ls -l`[m
