[32m+[m[32mexport function polysteliTransform(text: string): { text: string; markers: string[] } | null {[m
[32m+[m[32m  if (text.includes(MARKER)) return null;[m
[32m+[m[32m  const lines = text.split('\n');[m
[32m+[m[32m  const markers: string[] = [];[m
[32m+[m[32m  const out: string[] = [];[m
[32m+[m[32m  let i = 0, changed = false;[m
[32m+[m[32m  while (i < lines.length) {[m
[32m+[m[32m    if (!lines[i]!.length) { out.push(lines[i]!); i++; continue; }[m
[32m+[m[32m    let j = i;[m
[32m+[m[32m    while (j < lines.length && lines[j]!.length) j++;[m
