[32m+[m[32mexport function polysteliSelfTest(enc: EncodingName = 'o200k_base'): { pass: number; fail: number; log: string[] } {[m
[32m+[m[32m  const log: string[] = [];[m
[32m+[m[32m  let pass = 0, fail = 0;[m
[32m+[m[32m  const check = (name: string, cond: boolean): void => {[m
[32m+[m[32m    if (cond) { pass++; log.push(`ok   ${name}`); } else { fail++; log.push(`FAIL ${name}`); }[m
[32m+[m[32m  };[m
[32m+[m[32m  const row = (size: string, tail: string): string => `drwxr-xr-x   2 root  root  ${size}   ${tail}\n`;[m
[32m+[m[32m  const table = 'PERMS   LINK OWNER GRP  SIZE\n'[m
[32m+[m[32m    + row('60', 'alpha beta gamma') + row('496', 'file.o') + row('128', 'dir with spaces')[m
[32m+[m[32m    + row('60', 'audit') + row('128', 'engines-3') + row('60', 'bfd-plugins')[m
[32m+[m[32m    + row('4096', 'cryptsetup') + row('60', 'e2fsprogs');[m
[32m+[m[32m  const tr = polysteliTransform(table);[m
[32m+[m[32m  check('header passes through, rows fit', !!tr && tr.text.split('\n')[1]!.startsWith(MARKER) && tr.markers.length === 1);[m
[32m+[m[32m  if (tr) {[m
[32m+[m[32m    check('undo round-trip', polysteliUndo(tr.text) === table);[m
[32m+[m[32m    check('marker parses', polysteliParseMarker(tr.markers[0]!) !== null);[m
