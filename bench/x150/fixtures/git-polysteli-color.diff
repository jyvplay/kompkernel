[32m+[m[32mimport { countTokens, type EncodingName } from './bpe';[m
[32m+[m[32mimport { tagstackEncode, type TagstackResult } from './tagstack';[m
[32m+[m
[32m+[m[32mconst MARKER = '॥';[m
[32m+[m[32mconst MIN_ROWS = 6;[m
[32m+[m[32mconst MIN_PAD = 24;[m
[32m+[m[32mconst MIN_FIELDS = 4;[m
[32m+[m
[32m+[m[32mexport interface PolysteliGrid {[m
[32m+[m[32m  /** per-column widths; field k ends at the cumulative edge of widths[0..k] */[m
[32m+[m[32m  widths: number[];[m
[32m+[m[32m  rows: string[][];[m
[32m+[m[32m  tails: string[];[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32minterface Stretch { grid: PolysteliGrid; padMass: number }[m
[32m+[m
[32m+[m[32m/** Right-edge tile fit: field k is the token ENDING at the k-th uniform edge. */[m
[32m+[m[32mfunction fitStretch(lines: string[]): Stretch | null {[m
[32m+[m[32m  const parsed: [string, number, number][][] = [];[m
[32m+[m[32m  for (const l of lines) {[m
[32m+[m[32m    if (l.includes('\t') || l.includes('\r')) return null;[m
[32m+[m[32m    const f: [string, number, number][] = [];[m
[32m+[m[32m    const re = /\S+/g;[m
[32m+[m[32m    let m: RegExpExecArray | null;[m
[32m+[m[32m    while ((m = re.exec(l))) f.push([m[0], m.index, m.index + m[0].length]);[m
[32m+[m[32m    if (!f.length || f[0]![1] !== 0) return null;     // margin-zero grids only[m
[32m+[m[32m    parsed.push(f);[m
[32m+[m[32m  }[m
[32m+[m[32m  const n = Math.min(...parsed.map((f) => f.length));[m
[32m+[m[32m  if (n < MIN_FIELDS) return null;[m
[32m+[m[32m  const ends: number[] = [];[m
[32m+[m[32m  for (let c = 0; c < n; c++) {[m
[32m+[m[32m    const set = new Set(parsed.map((f) => f[c]![2]));[m
[32m+[m[32m    if (set.size !== 1) break;[m
[32m+[m[32m    ends.push(parsed[0]![c]![2]);[m
[32m+[m[32m  }[m
[32m+[m[32m  if (ends.length < MIN_FIELDS) return null;[m
[32m+[m[32m  const widths: number[] = [];[m
[32m+[m[32m  let prev = 0;[m
[32m+[m[32m  for (const e of ends) { widths.push(e - prev); prev = e; }[m
[32m+[m[32m  const rows: string[][] = [], tails: string[] = [];[m
[32m+[m[32m  let padMass = 0;[m
[32m+[m[32m  for (const [i, f] of parsed.entries()) {[m
[32m+[m[32m    if (f.length < ends.length) return null;[m
[32m+[m[32m    const row: string[] = [];[m
[32m+[m[32m    for (let c = 0; c < ends.length; c++) {[m
[32m+[m[32m      const t = f[c]!;[m
[32m+[m[32m      if (t[2] !== ends[c]!) return null;             // row breaks the tile[m
[32m+[m[32m      row.push(t[0]);[m
[32m+[m[32m    }[m
[32m+[m[32m    for (let c = 0; c < ends.length; c++) padMass += widths[c]! - row[c]!.length;[m
[32m+[m[32m    const tail = lines[i]!.slice(ends[ends.length - 1]!);[m
[32m+[m[32m    if (tail.length && !/\s/.test(tail[0]!)) return null;[m
[32m+[m[32m    rows.push(row); tails.push(tail);[m
[32m+[m[32m  }[m
[32m+[m[32m  if (padMass < MIN_PAD) return null;[m
[32m+[m[32m  return { grid: { widths, rows, tails }, padMass };[m
[32m+[m[32m}[m
