user 4534 0.0 3932 3048 ? S 07:11 0:00 /bin/bash -l -c cat > /tmp/eat.py <<'EOF' import sys, time mb = int(sys.argv[1]) buf = bytearray(mb * 1024 * 1024) for i in range(0, len(buf), 4096): buf[i] = 1 time.sleep(600) EOF python3 - <<'PY' import random, subprocess, time, os, signal random.seed(0x53) procs=[] sizes=[] # log-uniform sizes 3..160 MB, cap total ~2.2GB total=0 for i in range(110):     mb=int(3*(160/3)**random.random())     if total+mb>2200: break     sizes.append(mb); total+=mb print('spawning',len(sizes),'total MB',total) for mb in sizes:     procs.append(subprocess.Popen(['python3','/tmp/eat.py',str(mb)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)) time.sleep(6) out=subprocess.run(['ps','aux'],capture_output=True,text=True).stdout open('/home/user/kompkernel/bench/x53/fixtures/ps-bigmem.txt','w').write(out) for p in procs: p.terminate() print('captured lines', out.count('\n')) PY wc -l bench/x53/fixtures/ps-bigmem.txt; awk 'NR>1{print $4}' bench/x53/fixtures/ps-bigmem.txt | sort -u | tr '\n' ' ' | head -c 300
