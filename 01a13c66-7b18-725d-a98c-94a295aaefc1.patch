+  if (m) { const cur = scope[scope.length - 1]; const stem = m[2].replace(/_$/, ''); console.log(i + 1, 'depth', scope.length, 'stem', stem, 'cur0', cur[0], 'eq', cur.length && cur[0] + '/' + stem === m[3]); cur.push(m[3]); shown++; }
