diff --git a/bench/z50/make-excerpt.ts b/bench/z50/make-excerpt.ts
new file mode 100644
index 0000000..3d5feaf
--- /dev/null
+++ b/bench/z50/make-excerpt.ts
@@ -0,0 +1,16 @@
+// z50: write the first N whole "node_modules/…" entries (that carry a resolved line) of a real lockfile,
+// wrapped in a valid JSON skeleton. Usage: make-excerpt.ts <lockfile> <N>   (prints the excerpt to stdout)
+import fs from 'node:fs';
+const [f, nArg] = process.argv.slice(2);
+const src = fs.readFileSync(f, 'utf8').split('\n');
+const pick: string[] = [];
+for (let i = 0, n = 0; i < src.length && n < Number(nArg); i++) {
+  if (!/^ {4}"node_modules\/[^"]*": \{$/.test(src[i])) continue;
+  let j = i + 1; while (src[j] !== '    },' && src[j] !== '    }') j++;
+  const block = src.slice(i, j + 1);
+  if (block.some(l => /^ {6}"resolved": /.test(l))) { pick.push(...block); n++; }
+  i = j;
+}
+const text = '{\n  "packages": {\n' + pick.join('\n').replace(/\n    \},?$/, '\n    }').replace(/,\s*$/, '') + '\n  }\n}\n';
+JSON.parse(text);
+process.stdout.write(text);
diff --git a/bench/z50/probe-reduce.ts b/bench/z50/probe-reduce.ts
new file mode 100644
index 0000000..6819ea6
--- /dev/null
+++ b/bench/z50/probe-reduce.ts
@@ -0,0 +1,12 @@
+// z50: unit probe of the SYNARTESIS pre-pass (no DAEDALUS): elided count, restore exactness, timing.
+import fs from 'node:fs';
+import { synReduce, synRestore } from '@/lib/omega/synartesis';
+for (const f of process.argv.slice(2)) {
+  const text = fs.readFileSync(f, 'utf8');
+  const t0 = Date.now();
+  const r = synReduce(text);
+  const dt = Date.now() - t0;
+  if (!r) { console.log(JSON.stringify({ f, eligible: false })); continue; }
+  const back = synRestore(r.reduced);
+  console.log(JSON.stringify({ f, eligible: true, elided: r.elided, bytesIn: text.length, bytesReduced: r.reduced.length, restoreExact: back === text, ms: dt }));
+}
