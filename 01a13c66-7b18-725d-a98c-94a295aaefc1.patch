+// X16: split the DAEDALUS-D one-chat message into decoder contract tokens and wire tokens, per lane.
+import fs from 'node:fs';
+import { daedalusDualEncode } from '@/lib/omega/daedalus-dual';
+import { countTokens } from '@/lib/omega/bpe';
+for (const f of process.argv.slice(2)) {
+  const text = fs.readFileSync(f, 'utf8');
+  const r = daedalusDualEncode(text, 'o200k_base');
+  const M = r.messageTokens.o200k_base;
+  const wireT = countTokens(r.wire, 'o200k_base');
+  const rawT = countTokens(text, 'o200k_base');
+  console.log(JSON.stringify({ file: f.split('/').slice(-1)[0], mode: r.mode, rawTok: rawT, M, wireTok: wireT, contractTok: r.mode === 'daedalus' ? M - wireT : 0, winningArm: r.winningArm }));
+}
diff --git a/bench/x16/survey_paras.py b/bench/x16/survey_paras.py
new file mode 100644
index 0000000..0575467
--- /dev/null
+++ b/bench/x16/survey_paras.py
@@ -0,0 +1,32 @@
+# X16 survey: near-duplicate paragraph pairs inside single real files.
+# Paragraph = blank-line-separated block with >= 25 words. Similarity = Jaccard of word 3-grams.
+# Reports, per file: number of paragraphs, number of (later, earlier) pairs with similarity >= 0.5.
+import sys, re, os, json
+def shingles(words, n=3):
+    return {tuple(words[i:i+n]) for i in range(len(words)-n+1)}
+res = []
+for path in sys.argv[1:]:
+    try:
+        text = open(path, encoding='utf8', errors='strict').read()
+    except Exception:
+        continue
+    paras = [p for p in re.split(r'\n\s*\n', text) if len(p.split()) >= 25]
+    if len(paras) < 2:
+        continue
+    sh = [shingles(p.split()) for p in paras]
+    pairs = []
+    for j in range(len(paras)):
+        best = (0.0, -1)
+        for i in range(j):
+            a, b = sh[i], sh[j]
+            if not a or not b: continue
+            s = len(a & b) / len(a | b)
+            if s > best[0]: best = (s, i)
+        if best[0] >= 0.5:
+            pairs.append({'later': j, 'earlier': best[1], 'jaccard': round(best[0], 3), 'words_later': len(paras[j].split())})
+    if pairs:
+        res.append({'file': path, 'paras': len(paras), 'pairs': len(pairs), 'words_in_pairs': sum(p['words_later'] for p in pairs), 'bytes': len(text), 'max_j': max(p['jaccard'] for p in pairs)})
+res.sort(key=lambda r: -r['words_in_pairs'])
+for r in res[:40]:
+    print(json.dumps(r))
+print('files_with_pairs', len(res))
diff --git a/bench/x16/typo-probe.mjs b/bench/x16/typo-probe.mjs
new file mode 100644
index 0000000..4b69f05
--- /dev/null
+++ b/bench/x16/typo-probe.mjs
@@ -0,0 +1,13 @@
+// X16 probe: token cost of typographic punctuation in real prose/markdown files (raw o200k, no codec).
+import fs from 'node:fs';
+import { encode } from 'gpt-tokenizer/encoding/o200k_base';
+const files = process.argv.slice(2);
+for (const f of files) {
+  const t = fs.readFileSync(f, 'utf8');
+  const curly = (t.match(/[\u201C\u201D\u2018\u2019]/g) || []).length;
+  const dash = (t.match(/\u2014|\u2013/g) || []).length;
+  const ell = (t.match(/\u2026/g) || []).length;
+  const norm = t.replace(/[\u201C\u201D]/g, '"').replace(/[\u2018\u2019]/g, "'").replace(/\u2014/g, '--').replace(/\u2013/g, '-').replace(/\u2026/g, '...');
+  const a = encode(t).length, b = encode(norm).length;
+  console.log(JSON.stringify({ file: f, curly, dash, ell, rawTok: a, normTok: b, saved: a - b }));
+}
