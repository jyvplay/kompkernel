@@ -0,0 +1,239 @@
+/**
+ * src/lib/omega/dendron.ts
+ * =============================================================================
+ * ΔΕΝΔΡΟΝ — a path or URL list written as a tree of bash brace groups
+ * (byte-perfect, exact-lossless, single-chat-readable, contract in band)
+ * -----------------------------------------------------------------------------
+ * δένδρον — "tree". A list of paths or URLs is a set of strings with shared
+ * prefixes. The frontier writes each line in full, and DAEDALUS folds the
+ * repeated prefix into one glyph per line. That costs one token per line for
+ * the prefix, however deep the tree is.
+ *
+ * THE MECHANISM (not a dictionary)
+ * -----------------------------------------------------------------------------
+ * Brace expansion is a notation the reader already knows exactly (bash, zsh,
+ * Makefile patterns, git refspecs). `src/{lib/omega/a.ts,lib/omega/b.ts}` names
+ * two paths, and the reader expands it by a rule it does not have to be taught
+ * in detail: the text before `{` is joined to each comma item, in order, and
+ * groups nest. A run of consecutive lines that share a first segment becomes
+ * one group, so the shared text is written once per level of the tree, not
+ * once per line. A glyph dictionary cannot express this structure: it can name
+ * a repeated string, but each line still needs one reference to it.
+ *
+ * MEASURED (o200k, OMEGA_DET=1, M = tokens(contract + wire) of the one-chat message;
+ * receipts: bench/z51/receipts/sweep-dendron.jsonl, redteam-dendron.log, probes.txt)
+ * -----------------------------------------------------------------------------
+ *   git ls-files, first 400 files         M 1563 → 1461  (−102, −6.5%)  tree arm
+ *   markdown paths under bench/ (169)     M 1099 → 1080  (−19,  −1.7%)  tree arm
+ *   git ls-files, first 160 lines         M  695 →  682  (−13,  −1.9%)  tree arm
+ *   git ls-files, first 80 / 40 / 24      M  359 / 222 / 168: tree arm loses → frontier
+ *   find, 233 src/lib/omega files         M  767 →  767  (tree arm not cheaper → frontier)
+ *   find, 120 timestamped lines (listing) M 1326 → 1326  (tree arm not cheaper → frontier)
+ *   450 unique URLs (12 are URI templates with { })      refused → frontier
+ *   prose, JSON, diff, table, ls, npm ls  identical (no eligible tree, or tree larger)
+ * Break-even is near 120–160 listing lines: the 35-token rule sentence has to be
+ * paid back by the braces saved, and a flat run of short paths saves less than that.
+ * A tree is not always cheaper: a dense flat listing already costs one glyph per
+ * line in DAEDALUS, and the braces cost what the glyphs cost, so the arm loses.
+ * The guard keeps the frontier in every such case.
+ *
+ * WIRE
+ * -----------------------------------------------------------------------------
+ *   line 1   DEN_RULE (the contract, one sentence; it is also the dispatch key)
+ *   rest     the DAEDALUS wire of the tree text (its own contract follows it)
+ * Or, when the frontier is cheaper, the plain DAEDALUS wire unchanged.
+ * A payload that already contains a line equal to DEN_RULE or DEN_ESCAPE is
+ * sent with DEN_ESCAPE first, so the reader cannot mistake it for a tree.
+ *
+ * APPLICABILITY (every one is checked; otherwise the frontier is returned)
+ *   · at least 3 lines (a trailing newline is an empty last line, which is fine);
+ *   · no line contains `{`, `}` or `,` (those would need escapes; whitespace is literal);
+ *   · at least 2 lines contain `/`;
+ *   · the tree expands back to the input exactly (expander below, checked).
+ *
+ * EXACTNESS
+ *   The expander is the grammar the encoder writes: a line is a sequence of
+ *   literals and groups, a group is `{seq(,seq)*}`, groups with one item are
+ *   never written (the encoder writes the item bare). The encoder checks the
+ *   expansion, then the full composed decode; any mismatch returns the frontier.
+ *   Scope: any line list whose lines are free of { } , (paths, URLs, identifiers).
+ *   The tree arm is taken only when it is cheaper, so other lists fall back.
+ * =============================================================================
+ */
+
+import { now } from './clock';
+import { countTokens, type EncodingName } from './bpe';
+import { chironDecode } from './chiron';
+import { daedalusEncode, type DaedalusOptions } from './daedalus';
+
+/** Line 1 of the tree wire. It is the contract and the dispatch key. */
+export const DEN_RULE = '∴ paths: bash brace expressions ({a,b} = text before it + a, and + b; groups nest). Expand after other rules; one path per line.';
+/** Line 1 when the payload itself contains DEN_RULE or DEN_ESCAPE as a line. */
+export const DEN_ESCAPE = '∴ paths: literal payload follows';
+
+/* ---------------------------------------------------------------------------
+ * 1. Tree builder (encoder side).
+ *    Consecutive lines that share their first segment (up to and including the
+ *    first '/') form one group. A group of one item is written bare.
+ * ------------------------------------------------------------------------- */
+export function denTree(lines: string[]): string[] {
+  const rec = (xs: string[]): string[] => {
+    const out: string[] = [];
+    let i = 0;
+    while (i < xs.length) {
+      const k = xs[i].indexOf('/');
+      if (k < 0) { out.push(xs[i]); i++; continue; }
+      const head = xs[i].slice(0, k + 1);
+      let j = i + 1;
+      while (j < xs.length && xs[j].startsWith(head)) j++;
+      if (j - i < 2) { out.push(xs[i]); i++; continue; }
+      const items = rec(xs.slice(i, j).map(x => x.slice(head.length)));
+      out.push(items.length === 1 ? head + items[0] : head + '{' + items.join(',') + '}');
+      i = j;
+    }
+    return out;
+  };
+  return rec(lines);
+}
+
+/* ---------------------------------------------------------------------------
+ * 2. Expander (reader side). Left-to-right, order-preserving.
+ * ------------------------------------------------------------------------- */
+function expandSeq(s: string, st: { p: number }): string[] {
+  let acc: string[] = [''];
+  while (st.p < s.length && s[st.p] !== ',' && s[st.p] !== '}') {
+    if (s[st.p] === '{') {
+      st.p++;
+      const alts: string[] = [];
+      for (;;) {
+        alts.push(...expandSeq(s, st));
+        if (st.p >= s.length) throw new Error('dendron: unterminated {');
+        if (s[st.p] === ',') { st.p++; continue; }
+        st.p++; // '}'
+        break;
+      }
+      const next: string[] = [];
+      for (const a of acc) for (const b of alts) next.push(a + b);
+      acc = next;
+    } else {
+      const c = s[st.p++];
+      acc = acc.map(a => a + c);
+    }
+  }
+  return acc;
+}
+
+/** Expand one line. Throws on a malformed expression (a stray `}` or `,` at top level). */
+export function denExpandLine(line: string): string[] {
+  const st = { p: 0 };
+  const out = expandSeq(line, st);
+  if (st.p !== line.length) throw new Error('dendron: stray } or , at top level');
+  return out;
+}
+
+/** Expand a whole tree text. Lines are expanded in order and joined with \n. */
+export function denExpand(treeText: string): string {
+  return treeText.split('\n').flatMap(denExpandLine).join('\n');
+}
+
+/* ---------------------------------------------------------------------------
+ * 3. Applicability.
+ * ------------------------------------------------------------------------- */
+export function denLines(text: string): string[] | null {
+  if (!text) return null;
+  const lines = text.split('\n');
+  if (lines.length < 3) return null;
+  /* An empty line expands to the empty string, so a trailing newline (an empty
+   * last line) and an interior empty line both round-trip without a flag. */
+  /* Whitespace is literal in a brace expression, so it needs no restriction;
+   * only the three syntax characters do. */
+  for (const l of lines) if (/[{},]/.test(l)) return null;
+  if (lines.filter(l => l.includes('/')).length < 2) return null;
+  return lines;
+}
+
+/* ---------------------------------------------------------------------------
+ * 4. Decoder. Dispatch on line 1, then the DAEDALUS decoder, then the expander.
+ * ------------------------------------------------------------------------- */
+export function denDecode(wire: string): string {
+  const nl = wire.indexOf('\n');
+  const first = nl < 0 ? wire : wire.slice(0, nl);
+  const rest = nl < 0 ? '' : wire.slice(nl + 1);
+  if (first === DEN_RULE) return denExpand(chironDecode(rest));
+  if (first === DEN_ESCAPE) return chironDecode(rest);
+  return chironDecode(wire);
+}
+
+/* ---------------------------------------------------------------------------
+ * 5. Encoder. Two arms: the frontier (plain DAEDALUS) and the tree arm.
+ *    The tree arm is kept only if it is strictly cheaper and round-trips.
+ * ------------------------------------------------------------------------- */
+export interface DendronResult {
+  codec: 'dendron';
+  wire: string;
+  decoded: string;
+  exact: boolean;
+  inTokens: number;
+  outTokens: number;
+  messageTokens: number;
+  contractTokens: number;
+  decoderPrompt: string;
+  /** true when the tree arm was used */
+  applied: boolean;
+  /** M of the frontier arm (plain DAEDALUS) */
+  frontierM: number;
+  /** M of the tree arm, when it was computed */
+  treeM: number | null;
+  treeLines: number;
+  notes: string;
+  ms: number;
+}
+
+export function denEncode(text: string, enc: EncodingName = 'o200k_base', options: DaedalusOptions = {}): DendronResult {
+  const started = now();
+  const plain = daedalusEncode(text, enc, options);
+  const frontierM = plain.messageTokens;
+  const base = (over: Partial<DendronResult>): DendronResult => ({
+    codec: 'dendron', wire: plain.wire, decoded: text, exact: true,
+    inTokens: plain.inTokens, outTokens: plain.outTokens, messageTokens: frontierM,
+    contractTokens: plain.contractTokens, decoderPrompt: plain.decoderPrompt,
+    applied: false, frontierM, treeM: null, treeLines: 0, notes: '', ms: now() - started, ...over,
+  });
+
+  // The plain arm must dispatch to itself. A payload that carries a dispatch line is escaped.
+  const carries = text.split('\n').some(l => l === DEN_RULE || l === DEN_ESCAPE);
+  const plainDispatches = !carries && denDecode(plain.wire) === text;
+  if (!plainDispatches) {
+    const wire = DEN_ESCAPE + '\n' + plain.wire;
+    const prompt = DEN_ESCAPE + '\n' + plain.decoderPrompt;
+    const M = countTokens(prompt, enc);
+    return base({
+      wire, decoderPrompt: prompt, messageTokens: M, contractTokens: M - countTokens(wire, enc),
+      outTokens: countTokens(wire, enc), exact: denDecode(wire) === text,
+      notes: 'escape: payload carries a dispatch line (or the plain arm did not dispatch)',
+    });
+  }
+
+  const lines = denLines(text);
+  if (!lines) return base({ notes: 'not applicable: lines must be non-empty single tokens with at least 2 containing "/"' });
+  const tree = denTree(lines);
+  const treeText = tree.join('\n');
+  if (denExpand(treeText) !== text) return base({ treeLines: tree.length, notes: 'refused: tree does not expand back to the input' });
+
+  const td = daedalusEncode(treeText, enc, options);
+  const wire = DEN_RULE + '\n' + td.wire;
+  const prompt = DEN_RULE + '\n' + td.decoderPrompt;
+  const treeM = countTokens(prompt, enc);
+  const exact = denDecode(wire) === text;
+  if (!exact) return base({ treeM, treeLines: tree.length, notes: 'refused: tree arm failed the round trip' });
+  if (treeM >= frontierM) return base({ treeM, treeLines: tree.length, notes: `frontier wins: tree arm ${treeM} >= ${frontierM}` });
+
+  return {
+    codec: 'dendron', wire, decoded: text, exact: true,
+    inTokens: plain.inTokens, outTokens: countTokens(wire, enc), messageTokens: treeM,
+    contractTokens: treeM - countTokens(wire, enc), decoderPrompt: prompt,
+    applied: true, frontierM, treeM, treeLines: tree.length,
+    notes: `tree arm: ${lines.length} lines in ${tree.length} top-level items; M ${treeM} vs frontier ${frontierM} (${treeM - frontierM})`,
+    ms: now() - started,
+  };
+}
diff --git a/src/lib/omega/dendrons.ts b/src/lib/omega/dendrons.ts
new file mode 100644
index 0000000..3dc37d4
--- /dev/null
+++ b/src/lib/omega/dendrons.ts
@@ -0,0 +1,302 @@
+/**
+ * src/lib/omega/dendrons.ts
+ * =============================================================================
+ * ΔΕΝΔΡΟΝ-Σ (DENDRON-S) — the brace tree on ANY separator, with verbatim lines
+ * (byte-perfect, exact-lossless, single-chat-readable, contract in band)
+ * -----------------------------------------------------------------------------
+ * DENDRON (dendron.ts) factors a list of paths. It splits each line at the
+ * first '/', so it cannot see the shared prefix of a dotted identifier list:
+ *
+ *     net.ipv4.conf.all.arp_filter = 0
+ *     net.ipv4.conf.all.arp_ignore = 0
+ *     net.ipv4.conf.default.arp_filter = 0
+ *
+ * is written in full by the frontier, one prefix glyph per line. DENDRON-S
+ * splits at the separator that factors best ('.' or '/' — the encoder measures
+ * both), and writes the shared head once per group:
+ *
+ *     net.ipv4.conf.{all.arp_filter = 0,all.arp_ignore = 0,default.arp_filter = 0}
+ *
+ * The reader needs no knowledge of the separator. It expands bash brace
+ * expressions, which is the same rule DENDRON already uses. Only the encoder
+ * chooses the separator.
+ *
+ * WHAT IS NEW OVER DENDRON (the mechanism, not a rename)
+ * -----------------------------------------------------------------------------
+ *   1. Separator choice by measurement. The factoring unit is decided per
+ *      payload by one-chat M, so dotted identifiers (sysctl, config keys,
+ *      Java/Python dotted names, reverse-DNS) become eligible, not only paths.
+ *   2. Verbatim lines inside the tree. A line that contains { } , — or starts
+ *      with ! — is written as "!" + line and is copied through unchanged. A
+ *      tree no longer has to be refused when a few lines carry braces or
+ *      commas (DENDRON refused the whole list). The "!" marker is unambiguous
+ *      because no tree line can start with "!": a tree line begins with the
+ *      first segment of an eligible line, and eligible lines never start with
+ *      "!".
+ *   3. A verbatim run breaks the tree, so a group never straddles a literal
+ *      line, and the reader never has to guess a group's extent.
+ *
+ * WIRE
+ * -----------------------------------------------------------------------------
+ *   line 1   DENS_RULE (the contract, one sentence; it is also the dispatch key)
+ *   rest     the DAEDALUS wire of the tree text (its own contract follows it)
+ * Or the plain DAEDALUS wire (frontier), when it is cheaper or the tree arm
+ * fails its round trip. A payload whose plain wire would carry a dispatch line
+ * is sent with DENS_ESCAPE first.
+ *
+ * EXACTNESS
+ *   The encoder checks (a) the tree expands back to the input, then (b) the full
+ *   composed decode: chironDecode → verbatim/expand per line. Any mismatch
+ *   returns the frontier. The tree arm is taken only when its M is strictly
+ *   smaller. Byte-exactness is machine-checked in this file, not assumed.
+ * =============================================================================
+ */
+
+import { now } from './clock';
+import { countTokens, type EncodingName } from './bpe';
+import { chironDecode } from './chiron';
+import { daedalusEncode, type DaedalusOptions } from './daedalus';
+
+/** Line 1 of a tree wire with no verbatim lines: the contract and the dispatch key. */
+export const DENS_RULE = '∴ lines: bash brace expressions ({a,b} = text before it + a, and + b; groups nest). Expand after other rules; one line per result.';
+/** Line 1 of a tree wire that carries verbatim lines ("!" prefix). Only paid when used. */
+export const DENS_RULE_V = DENS_RULE + ' A line starting with ! is literal: drop that !, keep the rest.';
+/** DENS-2 dispatch lines (the encoder always writes these). A reader-level bash rule instead of a spelled-out
+ *  one: the reader already knows bash brace expansion, so the contract is 13 o200k tokens (was 35). */
+export const DENS2_RULE = '∴ lines: bash brace expansion; one result per line.';
+export const DENS2_RULE_V = '∴ lines: bash brace expansion; one result per line. A line starting with ! is literal: drop the !.';
+/** Line 1 when the payload's plain wire would itself dispatch as one of the DENS rules. */
+export const DENS_ESCAPE = '∴ lines: literal payload follows';
+
+/** Every first line the reader dispatches on (escape needed if a plain wire starts with one of them). */
+export const DENS_DISPATCH: string[] = [DENS_RULE, DENS_RULE_V, DENS2_RULE, DENS2_RULE_V, DENS_ESCAPE];
+
+/** Separators the encoder may factor on, in tie-break order. */
+export const DENS_SEPARATORS = ['.', '/'] as const;
+
+/* ---------------------------------------------------------------------------
+ * 1. Tree builder (encoder side).
+ *    Consecutive lines of one run that share their first segment (up to and
+ *    including the first `sep`) form one group. A one-item group is bare.
+ * ------------------------------------------------------------------------- */
+export function densTree(lines: string[], sep: string, merge = false): string[] {
+  const rec = (xs: string[]): string[] => {
+    const out: string[] = [];
+    let i = 0;
+    while (i < xs.length) {
+      const k = xs[i].indexOf(sep);
+      if (k < 0) { out.push(xs[i]); i++; continue; }
+      const head = xs[i].slice(0, k + 1);
+      let j = i + 1;
+      while (j < xs.length && xs[j].startsWith(head)) j++;
+      if (j - i < 2) { out.push(xs[i]); i++; continue; }
+      const items = rec(xs.slice(i, j).map(x => x.slice(head.length)));
+      out.push(items.length === 1 ? head + items[0] : head + '{' + items.join(',') + '}');
+      i = j;
+    }
+    return merge ? densMergeTails(out) : out;
+  };
+  return rec(lines);
+}
+
+/** Split an item into its literal part X and one trailing brace group T (X + T), or null. */
+export function densSplitTail(s: string): { x: string; tail: string } | null {
+  const k = s.indexOf('{');
+  if (k < 0) return null;
+  let depth = 0;
+  for (let i = k; i < s.length; i++) {
+    if (s[i] === '{') depth++;
+    else if (s[i] === '}') { depth--; if (depth === 0) return i === s.length - 1 ? { x: s.slice(0, k), tail: s.slice(k) } : null; }
+  }
+  return null;
+}
+
+/**
+ * Subtree merge (Cartesian factoring). Consecutive items X1+T, X2+T, ... that end in the SAME
+ * brace group T are written once as {X1,X2,...}T. The expansion is the same: for each X in order,
+ * every alternative of T in order, so the output order is unchanged.
+ */
+export function densMergeTails(items: string[]): string[] {
+  const out: string[] = [];
+  let i = 0;
+  while (i < items.length) {
+    const a = densSplitTail(items[i]);
+    if (!a) { out.push(items[i]); i++; continue; }
+    let j = i + 1;
+    while (j < items.length) {
+      const b = densSplitTail(items[j]);
+      if (!b || b.tail !== a.tail) break;
+      j++;
+    }
+    if (j - i < 2) { out.push(items[i]); i++; continue; }
+    const xs: string[] = [];
+    for (let t = i; t < j; t++) xs.push(densSplitTail(items[t])!.x);
+    out.push('{' + xs.join(',') + '}' + a.tail);
+    i = j;
+  }
+  return out;
+}
+
+/** A line must be written verbatim (escaped with "!") if it starts with "!" or holds a brace/comma. */
+export function densNeedsVerbatim(line: string): boolean {
+  return line.startsWith('!') || /[{},]/.test(line);
+}
+
+/** The wire lines for a payload: verbatim lines as "!"+line, eligible runs as trees on `sep`. */
+export function densWireLines(text: string, sep: string, merge = false): string[] {
+  const out: string[] = [];
+  let run: string[] = [];
+  const flush = () => { if (run.length) { out.push(...densTree(run, sep, merge)); run = []; } };
+  for (const l of text.split('\n')) {
+    if (densNeedsVerbatim(l)) { flush(); out.push('!' + l); } else run.push(l);
+  }
+  flush();
+  return out;
+}
+
+/* ---------------------------------------------------------------------------
+ * 2. Expander (reader side). Same brace grammar as DENDRON; left-to-right.
+ * ------------------------------------------------------------------------- */
+function expandSeq(s: string, st: { p: number }): string[] {
+  let acc: string[] = [''];
+  while (st.p < s.length && s[st.p] !== ',' && s[st.p] !== '}') {
+    if (s[st.p] === '{') {
+      st.p++;
+      const alts: string[] = [];
+      for (;;) {
+        alts.push(...expandSeq(s, st));
+        if (st.p >= s.length) throw new Error('dendrons: unterminated {');
+        if (s[st.p] === ',') { st.p++; continue; }
+        st.p++; // '}'
+        break;
+      }
+      const next: string[] = [];
+      for (const a of acc) for (const b of alts) next.push(a + b);
+      acc = next;
+    } else {
+      const c = s[st.p++];
+      acc = acc.map(a => a + c);
+    }
+  }
+  return acc;
+}
+
+/** Expand one wire line. A "!" line is verbatim; anything else is a brace expression. */
+export function densExpandLine(line: string): string[] {
+  if (line.startsWith('!')) return [line.slice(1)];
+  const st = { p: 0 };
+  const out = expandSeq(line, st);
+  if (st.p !== line.length) throw new Error('dendrons: stray } or , at top level');
+  return out;
+}
+
+/** Expand a whole tree text (lines in order, joined with \n). */
+export function densExpand(treeText: string): string {
+  return treeText.split('\n').flatMap(densExpandLine).join('\n');
+}
+
+/* ---------------------------------------------------------------------------
+ * 3. Decoder. Dispatch on line 1, then the DAEDALUS decoder, then the expander.
+ * ------------------------------------------------------------------------- */
+export function densDecode(wire: string): string {
+  const nl = wire.indexOf('\n');
+  const first = nl < 0 ? wire : wire.slice(0, nl);
+  const rest = nl < 0 ? '' : wire.slice(nl + 1);
+  if (first === DENS_RULE || first === DENS_RULE_V || first === DENS2_RULE || first === DENS2_RULE_V) return densExpand(chironDecode(rest));
+  if (first === DENS_ESCAPE) return chironDecode(rest);
+  return chironDecode(wire);
+}
+
+/* ---------------------------------------------------------------------------
+ * 4. Encoder. The frontier arm (plain DAEDALUS) and one tree arm per separator.
+ *    A tree arm is kept only when its one-chat M is strictly smaller AND the
+ *    composed decode reproduces the input byte for byte.
+ * ------------------------------------------------------------------------- */
+export interface DensResult {
+  codec: 'dendrons';
+  wire: string;
+  decoded: string;
+  exact: boolean;
+  inTokens: number;
+  outTokens: number;
+  messageTokens: number;
+  contractTokens: number;
+  decoderPrompt: string;
+  /** true when a tree arm was used */
+  applied: boolean;
+  /** separator of the chosen tree arm ('' when the frontier was chosen) */
+  sep: string;
+  /** M of the frontier arm (plain DAEDALUS) */
+  frontierM: number;
+  /** M of each tree arm that was computed, keyed by separator */
+  treeM: Record<string, number>;
+  treeLines: number;
+  notes: string;
+  ms: number;
+}
+
+export function densEncode(text: string, enc: EncodingName = 'o200k_base', options: DaedalusOptions = {}): DensResult {
+  const started = now();
+  const plain = daedalusEncode(text, enc, options);
+  const frontierM = plain.messageTokens;
+  const treeM: Record<string, number> = {};
+  const base = (over: Partial<DensResult>): DensResult => ({
+    codec: 'dendrons', wire: plain.wire, decoded: text, exact: true,
+    inTokens: plain.inTokens, outTokens: plain.outTokens, messageTokens: frontierM,
+    contractTokens: plain.contractTokens, decoderPrompt: plain.decoderPrompt,
+    applied: false, sep: '', frontierM, treeM, treeLines: 0, notes: '', ms: now() - started, ...over,
+  });
+
+  // The plain arm must dispatch to itself; a payload whose wire starts with a dispatch line is escaped.
+  const plainFirst = plain.wire.split('\n')[0];
+  if (DENS_DISPATCH.includes(plainFirst) || denSafePlain(plain.wire, text) === false) {
+    const wire = DENS_ESCAPE + '\n' + plain.wire;
+    const prompt = DENS_ESCAPE + '\n' + plain.decoderPrompt;
+    const M = countTokens(prompt, enc);
+    return base({
+      wire, decoderPrompt: prompt, messageTokens: M, contractTokens: M - countTokens(wire, enc),
+      outTokens: countTokens(wire, enc), exact: densDecode(wire) === text, treeM,
+      notes: 'escape: plain wire carries a dispatch line (or the plain arm did not dispatch)',
+    });
+  }
+
+  let best: DensResult | null = null;
+  let bestNote = '';
+  let treeLinesBest = 0;
+  for (const sep of DENS_SEPARATORS) {
+    const wl = densWireLines(text, sep);
+    const treeText = wl.join('\n');
+    // Only a tree that actually groups something can beat the frontier.
+    if (densExpand(treeText) !== text) { bestNote += ` ${sep}:refused(expand)`; continue; }
+    const td = daedalusEncode(treeText, enc, options);
+    const rule = wl.some(l => l.startsWith('!')) ? DENS2_RULE_V : DENS2_RULE;
+    const wire = rule + '\n' + td.wire;
+    const prompt = rule + '\n' + td.decoderPrompt;
+    const M = countTokens(prompt, enc);
+    treeM[sep] = M;
+    const exact = densDecode(wire) === text;
+    if (!exact) { bestNote += ` ${sep}:refused(round-trip)`; continue; }
+    if (M < frontierM && (!best || M < best.messageTokens)) {
+      treeLinesBest = wl.length;
+      best = {
+        codec: 'dendrons', wire, decoded: text, exact: true,
+        inTokens: plain.inTokens, outTokens: countTokens(wire, enc), messageTokens: M,
+        contractTokens: M - countTokens(wire, enc), decoderPrompt: prompt,
+        applied: true, sep, frontierM, treeM, treeLines: wl.length,
+        notes: '', ms: now() - started,
+      };
+    }
+  }
+  if (best) {
+    best.treeM = treeM;
+    best.notes = `tree arm sep=${JSON.stringify(best.sep)}: ${treeLinesBest} wire lines; M ${best.messageTokens} vs frontier ${frontierM} (${best.messageTokens - frontierM})`;
+    best.ms = now() - started;
+    return best;
+  }
+  return base({ treeLines: 0, notes: `frontier wins:${bestNote || ' no separator produced a cheaper tree'} (frontier ${frontierM})` });
+}
+
+/** The plain DAEDALUS wire must decode to the input through the dispatcher (it cannot carry a dispatch line). */
+function denSafePlain(plainWire: string, text: string): boolean {
+  try { return densDecode(plainWire) === text; } catch { return false; }
+}
