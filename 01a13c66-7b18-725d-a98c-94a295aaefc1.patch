new file mode 100644
index 0000000..cfec13a
--- /dev/null
+++ b/src/lib/omega/kladios.ts
@@ -0,0 +1,198 @@
+/**
+ * src/lib/omega/kladios.ts
+ * =============================================================================
+ * KLADOS (κλάδος, branch) — drawn-tree depth codec.
+ *
+ * THE GAP
+ * -----------------------------------------------------------------------------
+ * A drawn tree (`tree`, `npm ls`, `pipdeptree`, ...) spends most of its prefix
+ * characters on connectors and continuation bars. Those characters are a
+ * deterministic function of the depth sequence alone:
+ *   - a line at depth d has d-1 ancestor levels, each drawn as "bar" when that
+ *     ancestor has a later sibling and as "blank" otherwise;
+ *   - its own connector is "mid" when it has a later sibling, "last" otherwise.
+ * "Has a later sibling" is decided by the depth sequence (a later line at the
+ * same depth, before any shallower line). So the wire keeps only the depth and
+ * the text of each line; the reader redraws the prefix.
+ *
+ * MECHANISM CLASS
+ * -----------------------------------------------------------------------------
+ * Layout regeneration (GRAMMA: the layout is not shipped, the reader regenerates it).
+ * GRAMMA's dialects cover indentation of code and JSON. KLADOS covers drawn-tree
+ * connector glyphs, which are not indentation: they sit inside the text column.
+ * Two styles are supported, each with its own connector set:
+ *   ascii  "+-- " mid, "`-- " last, "| " bar, "  " blank (npm ls)
+ *   box    "├── " mid, "└── " last, "│   " bar, "    " blank (tree)
+ *
+ * WIRE
+ * -----------------------------------------------------------------------------
+ *   one line per source line:  <depth digit> <space> <text>
+ *   depth 0 = a line with no connector (root, summary, blank); text is the line.
+ * The message = KLADOS contract line + the DAEDALUS prompt of that wire. The
+ * DAEDALUS dictionary still runs on the wire (the depth digits and texts are
+ * ordinary text to it).
+ *
+ * BYTE-EXACTNESS
+ * -----------------------------------------------------------------------------
+ * The encoder redraws the wire with the same renderer the reader uses and
+ * requires byte equality with the input. Otherwise it returns identity (plain
+ * DAEDALUS). Depth above 9 is not representable and also returns identity.
+ */
+
+import { countTokens, type EncodingName } from './bpe';
+import { daedalusEncode, daedalusDecode, type DaedalusResult } from './daedalus';
+
+export type KladosStyle = 'ascii' | 'box';
+
+interface StyleSpec {
+  style: KladosStyle;
+  mid: string;
+  last: string;
+  bar: string;
+  blank: string;
+  /** a connector line: prefix of bars/blanks, then mid or last, then text */
+  re: RegExp;
+}
+
+const STYLES: Record<KladosStyle, StyleSpec> = {
+  ascii: {
+    style: 'ascii', mid: '+-- ', last: '`-- ', bar: '| ', blank: '  ',
+    re: /^((?:\| |  )*)(\+-- |`-- )(.*)$/,
+  },
+  box: {
+    // tree(1) draws each bar as "│" + two NBSP (U+00A0) + space; a blank level is four ordinary spaces.
+    style: 'box', mid: '├── ', last: '└── ', bar: '│\u00a0\u00a0 ', blank: '    ',
+    re: /^((?:│\u00a0\u00a0 |    )*)(├── |└── )(.*)$/,
+  },
+};
+
+export interface KladosLine { depth: number; text: string }
+
+/** Parse a drawn tree in one style. Lines without a connector are depth 0. */
+export function kladosParse(text: string, style: KladosStyle): KladosLine[] {
+  const spec = STYLES[style];
+  const width = style === 'ascii' ? 2 : 4;
+  return text.split('\n').map((line) => {
+    const m = spec.re.exec(line);
+    if (!m) return { depth: 0, text: line };
+    const prefixLen = m[1].length;
+    if (prefixLen % width !== 0) return { depth: 0, text: line };
+    return { depth: prefixLen / width + 1, text: m[3] };
+  });
+}
+
+/** Redraw lines in one style. The same routine is the reader's. */
+export function kladosRender(lines: KladosLine[], style: KladosStyle): string {
+  const spec = STYLES[style];
+  const n = lines.length;
+  // hasLater[i]: a later line at depth(i), before any line shallower than depth(i)
+  const hasLater: boolean[] = new Array(n).fill(false);
+  for (let i = 0; i < n; i++) {
+    const d = lines[i].depth;
+    if (d === 0) continue;
+    let j = i + 1;
+    let later = false;
+    while (j < n) {
+      if (lines[j].depth < d) break;
+      if (lines[j].depth === d) { later = true; break; }
+      j++;
+    }
+    hasLater[i] = later;
+  }
+  const out: string[] = [];
+  const at: number[] = []; // at[level] = most recent line index at that depth
+  for (let i = 0; i < n; i++) {
+    const { depth: d, text } = lines[i];
+    if (d === 0) {
+      at.length = 0;
+      at[0] = i;
+      out.push(text);
+      continue;
+    }
+    let prefix = '';
+    for (let l = 1; l < d; l++) {
+      const anc = at[l];
+      prefix += anc !== undefined && hasLater[anc] ? spec.bar : spec.blank;
+    }
+    prefix += hasLater[i] ? spec.mid : spec.last;
+    at.length = d;
+    at[d] = i;
+    out.push(prefix + text);
+  }
+  return out.join('\n');
+}
+
+/** Wire: "<depth> <text>" per line. */
+export function kladosWire(lines: KladosLine[]): string {
+  return lines.map((l) => `${l.depth} ${l.text}`).join('\n');
+}
+
+/** Inverse of kladosWire. Every wire line is "<digit> <text>"; anything else is malformed. */
+export function kladosUnwire(wire: string): KladosLine[] {
+  return wire.split('\n').map((line) => {
+    if (!/^[0-9] /.test(line)) throw new Error('kladios: wire line without a depth digit');
+    return { depth: Number(line[0]), text: line.slice(2) };
+  });
+}
+
+/** Exact encoding. Returns identity (depth-0 wire of the raw text) if no style round-trips with a tree. */
+export interface KladosResult {
+  codec: 'kladios';
+  style: KladosStyle | 'identity';
+  wire: string;
+  decoded: string;
+  exact: boolean;
+  inTokens: number;
+  messageTokens: number;
+  daedalus: DaedalusResult;
+  decoderPrompt: string;
+  notes: string;
+}
+
+export const KLADOS_CONTRACT: Record<KladosStyle, string> = {
+  ascii:
+    'KLADOS: each line is "depth text". Depth 0: print text. Depth d: print d-1 levels, each "| " if that level\'s line has a later sibling else "  ", then "+-- " if this line has a later sibling else "`-- ", then text. A later sibling = a later line at the same depth before any shallower line.',
+  box:
+    'KLADOS: each line is "depth text". Depth 0: print text. Depth d: print d-1 levels, each "│ + 2 NBSP + space" if that level\'s line has a later sibling else 4 spaces, then "├── " if this line has a later sibling else "└── ", then text. A later sibling = a later line at the same depth before any shallower line.',
+};
+
+export function kladosEncode(text: string, enc: EncodingName = 'o200k_base'): KladosResult {
+  const inTokens = countTokens(text, enc);
+  const candidates: { style: KladosStyle; wire: string; lines: KladosLine[] }[] = [];
+  for (const style of ['ascii', 'box'] as KladosStyle[]) {
+    const lines = kladosParse(text, style);
+    if (lines.some((l) => l.depth > 9)) continue;
+    if (!lines.some((l) => l.depth > 0)) continue; // no tree: nothing to gain
+    const redrawn = kladosRender(lines, style);
+    if (redrawn !== text) continue; // G1: the renderer inverts the parser on this input
+    const wire = kladosWire(lines);
+    if (kladosRender(kladosUnwire(wire), style) !== text) continue; // G2: through the wire format
+    candidates.push({ style, wire, lines });
+  }
+  let best: KladosResult | null = null;
+  for (const c of candidates) {
+    const d = daedalusEncode(c.wire, enc);
+    const exact = d.exact && daedalusDecode(d.wire) === c.wire && kladosRender(kladosUnwire(c.wire), c.style) === text;
+    if (!exact) continue;
+    const decoderPrompt = KLADOS_CONTRACT[c.style] + '\n' + d.decoderPrompt;
+    const M = countTokens(decoderPrompt, enc);
+    if (!best || M < best.messageTokens) {
+      best = {
+        codec: 'kladios', style: c.style, wire: d.wire, decoded: text, exact: true, inTokens,
+        messageTokens: M, daedalus: d, decoderPrompt,
+        notes: `style=${c.style}; lines=${c.lines.length}; wire tokens via DAEDALUS=${d.messageTokens}`,
+      };
+    }
+  }
+  if (best) return best;
+  const d = daedalusEncode(text, enc);
+  return {
+    codec: 'kladios', style: 'identity', wire: d.wire, decoded: d.decoded, exact: d.exact, inTokens,
+    messageTokens: d.messageTokens, daedalus: d, decoderPrompt: d.decoderPrompt, notes: 'identity: no drawn tree redraws exactly',
+  };
+}
+
+/** Library reader: DAEDALUS expansion of the wire, then the KLADOS redraw for the style. */
+export function kladosDecode(wire: string, style: KladosStyle): string {
+  return kladosRender(kladosUnwire(daedalusDecode(wire)), style);
+}
diff --git a/src/lib/omega/lakonikos-d.ts b/src/lib/omega/lakonikos-d.ts
new file mode 100644
index 0000000..7ccb32d
--- /dev/null
+++ b/src/lib/omega/lakonikos-d.ts
@@ -0,0 +1,68 @@
+/**
+ * ⟡ LAKONIKOS-D — the DAEDALUS-D wire with the LAKONIKOS terse decoder contract (X16).
+ * =============================================================================
+ * Composition, not a new mechanism:
+ *   - wire: daedalusDualEncode (DAEDALUS-D: dual-tokenizer glyph pool; same wire and decoder as DAEDALUS);
+ *   - contract: lakonikosDecoderPrompt (the rules sentence is shortened; repeat and list clauses are verbatim).
+ * Gate: the wire must decode byte-identically through chironDecode and the shortened prompt must be
+ * produced from the same wire; otherwise the codec returns the identity (raw text, no contract).
+ *
+ * Why this exists: LAKONIKOS was measured only on the plain DAEDALUS wire (bench/lakonikos-report-2026-10-10.md).
+ * The DAEDALUS-D wire is the frontier entry on most prose lanes, so the contract saving is re-measured against
+ * that frontier in X16 (bench/x16/receipts/leaders-x16.tsv).
+ *
+ * Token accounting: messageTokens = o200k (and cl100k) tokens of the full prompt (contract + wire).
+ * Disclosed: the wire comes from the DAEDALUS-D encoder, which has a wall-clock budget (OMEGA_DET=1 makes the
+ * clock constant for measurement runs).
+ */
+import { countTokens, type EncodingName } from './bpe';
+import { daedalusDualEncode } from './daedalus-dual';
+import { lakonikosDecoderPrompt } from './lakonikos';
+import { chironDecode, chironDecoderPrompt } from './chiron';
+
+export interface LakonikosDResult {
+  codec: 'lakonikos-d';
+  wire: string;
+  /** the full message to hand to a model: shortened decoder contract with the wire embedded */
+  decoderPrompt: string;
+  decoded: string;
+  exact: boolean;
+  mode: 'daedalus' | 'raw';
+  inTokens: Record<'o200k_base' | 'cl100k_base', number>;
+  messageTokens: Record<'o200k_base' | 'cl100k_base', number>;
+  /** the same message with the unshortened DAEDALUS-D contract, for the saving */
+  messageTokensDualOld: Record<'o200k_base' | 'cl100k_base', number>;
+  winningArm: string;
+  notes: string;
+}
+
+export function lakonikosDualEncode(text: string, enc: EncodingName = 'o200k_base'): LakonikosDResult {
+  const d = daedalusDualEncode(text, enc);
+  const inTok = d.inTokens;
+  if (d.mode !== 'daedalus') {
+    return {
+      codec: 'lakonikos-d', wire: text, decoderPrompt: '', decoded: text, exact: true, mode: 'raw',
+      inTokens: inTok, messageTokens: inTok, messageTokensDualOld: inTok,
+      winningArm: d.winningArm, notes: 'identity: DAEDALUS-D did not pay',
+    };
+  }
+  const oldPrompt = chironDecoderPrompt(d.wire);
+  if (oldPrompt !== d.decoderPrompt) throw new Error('LAKONIKOS-D: DAEDALUS-D prompt is not chironDecoderPrompt(wire)');
+  const prompt = lakonikosDecoderPrompt(d.wire);
+  const decoded = chironDecode(d.wire);
+  const exact = decoded === text;
+  if (!exact) {
+    return {
+      codec: 'lakonikos-d', wire: text, decoderPrompt: '', decoded: text, exact: true, mode: 'raw',
+      inTokens: inTok, messageTokens: inTok, messageTokensDualOld: inTok,
+      winningArm: d.winningArm, notes: 'identity: wire failed the chironDecode round trip',
+    };
+  }
+  const tokens = { o200k_base: countTokens(prompt, 'o200k_base'), cl100k_base: countTokens(prompt, 'cl100k_base') };
+  return {
+    codec: 'lakonikos-d', wire: d.wire, decoderPrompt: prompt, decoded, exact: true, mode: 'daedalus',
+    inTokens: inTok, messageTokens: tokens, messageTokensDualOld: d.messageTokens,
+    winningArm: d.winningArm,
+    notes: `arm=${d.winningArm}; o200k ${d.messageTokens.o200k_base}->${tokens.o200k_base}; cl100k ${d.messageTokens.cl100k_base}->${tokens.cl100k_base}`,
+  };
+}
diff --git a/src/lib/omega/onomasia.ts b/src/lib/omega/onomasia.ts
new file mode 100644
index 0000000..e81d1b2
--- /dev/null
+++ b/src/lib/omega/onomasia.ts
@@ -0,0 +1,199 @@
+/**
+ * src/lib/omega/onomasia.ts
+ * =============================================================================
+ * ONOMASIA (ὀνομασία, "naming") — KEYED arithmetic-progression elision.
+ *
+ * WHAT IT ADDS OVER AKOLOUTHIA (measured, bench/z56/keyed-probe.jsonl)
+ * -----------------------------------------------------------------------------
+ * AKOLOUTHIA addresses a number by ORDINAL POSITION: "the k-th digit run in the
+ * line". Any line whose count of numbers differs shifts every later position and
+ * the progression is lost. ONOMASIA addresses a number by its KEY: the literal
+ * text immediately before it (back to the previous space or digit), plus j, the
+ * occurrence index of that key within the line. The reader finds the same key in
+ * the line above; no counting of unrelated numbers is needed.
+ *   - Ties AKOLOUTHIA on every lane where AKOLOUTHIA fires (gross, 43 lanes).
+ *   - Also fires on numbered references and time stamps in prose and ops text:
+ *     bibliography.txt −22, meeting-transcript.txt −14, markdown-table.md −6,
+ *     git-numstat.txt −5 (gross, before the contract).
+ *
+ * RULE (decoder)
+ * -----------------------------------------------------------------------------
+ * Slots are digit runs and markers, read left to right in each line. For a slot
+ * with key K and occurrence j in the line: a marker means
+ *     value(line i-1, K, j) + (value(line i-1, K, j) - value(line i-2, K, j))
+ * written in canonical decimal. The key of a marker is computed from the already
+ * decoded prefix of its own line, so the reader never looks ahead.
+ * The encoder additionally requires the same (K, j) slot in line i-3 with an equal
+ * step (three-term run), so that one coincidence does not fire a marker. The
+ * reader does not need that check.
+ *
+ * GATES (encoder; every failure returns the identity arm)
+ * -----------------------------------------------------------------------------
+ *   G1  onomasiaExpand(substituted) === input   (the reader's rule inverts the encoder)
+ *   G2  DAEDALUS round trip on the substituted text
+ *   G3  one-chat M (contract + DAEDALUS message) < plain DAEDALUS M
+ * Refused outright: input containing the marker character; numbers longer than 15
+ * digits; a marker in the first three lines.
+ *
+ * CONTRACT (one sentence in the message)
+ * -----------------------------------------------------------------------------
+ *   ⁺ = the number after the same text in the line above (that text is the characters just before it, back to a space or digit), plus the change from the line two above.
+ * =============================================================================
+ */
+
+import { countTokens, type EncodingName } from './bpe';
+import { daedalusEncode, daedalusDecode, type DaedalusResult } from './daedalus';
+
+export const ONOMASIA_MARK = '⁺';
+
+export const ONOMASIA_CONTRACT =
+  `${ONOMASIA_MARK} = the number after the same text in the line above (that text is the characters just before it, back to a space or digit), plus the change from the line two above.`;
+
+interface Slot { key: string; j: number; s: string; v: number; at: number }
+
+/** Key of the digit run starting at `at`: characters just before it, back to a space or digit. */
+function keyBefore(line: string, at: number): string {
+  let b = at;
+  while (b > 0 && line[b - 1] !== ' ' && !(line[b - 1] >= '0' && line[b - 1] <= '9')) b--;
+  return line.slice(b, at);
+}
+
+function slotsOf(line: string): Slot[] {
+  const out: Slot[] = [];
+  const seen = new Map<string, number>();
+  for (const m of line.matchAll(/[0-9]+/g)) {
+    const at = m.index ?? 0;
+    const key = keyBefore(line, at);
+    const j = seen.get(key) ?? 0;
+    seen.set(key, j + 1);
+    out.push({ key, j, s: m[0], v: Number(m[0]), at });
+  }
+  return out;
+}
+
+function findSlot(sl: Slot[], key: string, j: number): Slot | undefined {
+  return sl.find(x => x.key === key && x.j === j);
+}
+
+/** Encoder: replace eligible digit runs by the marker. */
+export function onomasiaSubstitute(text: string): { out: string; marks: number } {
+  const lines = text.split('\n');
+  const slots = lines.map(slotsOf);
+  let marks = 0;
+  const out = lines.map((line, i) => {
+    if (i < 3) return line;
+    const edits: { at: number; len: number }[] = [];
+    for (const c of slots[i]) {
+      const a = findSlot(slots[i - 1], c.key, c.j);
+      const b = findSlot(slots[i - 2], c.key, c.j);
+      const d = findSlot(slots[i - 3], c.key, c.j);
+      if (!a || !b || !d) continue;
+      const s = a.v - b.v;
+      if (s === 0 || b.v - d.v !== s) continue;
+      if (String(a.v) !== a.s || String(b.v) !== b.s || String(d.v) !== d.s) continue;
+      const want = String(a.v + s);
+      if (want !== c.s || want.length > 15) continue;
+      edits.push({ at: c.at, len: c.s.length });
+      marks++;
+    }
+    let r = line;
+    for (const e of edits.reverse()) r = r.slice(0, e.at) + ONOMASIA_MARK + r.slice(e.at + e.len);
+    return r;
+  });
+  return { out: out.join('\n'), marks };
+}
+
+/** Decoder (the reader's rule). Throws on a marker with no predecessor slot. */
+export function onomasiaExpand(text: string): string {
+  const lines = text.split('\n');
+  const decodedSlots: Slot[][] = [];
+  const out: string[] = [];
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    let res = '';
+    const mine: Slot[] = [];
+    const seen = new Map<string, number>();
+    let j = 0;
+    while (j < line.length) {
+      const ch = line[j];
+      if (ch === ONOMASIA_MARK) {
+        if (i < 2) throw new Error('onomasia: MARK in the first two lines');
+        const key = keyBefore(res, res.length);
+        const occ = seen.get(key) ?? 0;
+        const a = findSlot(decodedSlots[i - 1] ?? [], key, occ);
+        const b = findSlot(decodedSlots[i - 2] ?? [], key, occ);
+        if (!a || !b) throw new Error('onomasia: MARK without predecessor slots');
+        const v = a.v + (a.v - b.v);
+        const s = String(v);
+        res += s;
+        mine.push({ key, j: occ, s, v, at: res.length - s.length });
+        seen.set(key, occ + 1);
+        j++;
+        continue;
+      }
+      if (ch >= '0' && ch <= '9') {
+        let e = j;
+        while (e < line.length && line[e] >= '0' && line[e] <= '9') e++;
+        const s = line.slice(j, e);
+        const key = keyBefore(res, res.length);
+        const occ = seen.get(key) ?? 0;
+        res += s;
+        mine.push({ key, j: occ, s, v: Number(s), at: res.length - s.length });
+        seen.set(key, occ + 1);
+        j = e;
+        continue;
+      }
+      res += ch;
+      j++;
+    }
+    decodedSlots.push(mine);
+    out.push(res);
+  }
+  return out.join('\n');
+}
+
+export interface OnomasiaResult {
+  codec: 'onomasia';
+  arm: 'keyed' | 'identity';
+  wire: string;
+  decoded: string;
+  exact: boolean;
+  marks: number;
+  inTokens: number;
+  messageTokens: number;
+  daedalus: DaedalusResult;
+  decoderPrompt: string;
+  notes: string;
+}
+
+export function onomasiaEncode(text: string, enc: EncodingName = 'o200k_base'): OnomasiaResult {
+  const inTokens = countTokens(text, enc);
+  const plain = daedalusEncode(text, enc);
+  const identity: OnomasiaResult = {
+    codec: 'onomasia', arm: 'identity', wire: plain.wire, decoded: plain.decoded, exact: plain.exact,
+    marks: 0, inTokens, messageTokens: plain.messageTokens, daedalus: plain, decoderPrompt: plain.decoderPrompt,
+    notes: 'identity arm (DAEDALUS plain)',
+  };
+  if (text.includes(ONOMASIA_MARK)) return identity;
+  const { out, marks } = onomasiaSubstitute(text);
+  if (marks === 0) return identity;
+  if (onomasiaExpand(out) !== text) return identity;                       // G1
+  const d = daedalusEncode(out, enc);
+  if (!d.exact || daedalusDecode(d.wire) !== out) return identity;         // G2
+  const decoderPrompt = ONOMASIA_CONTRACT + '\n' + d.decoderPrompt;
+  const M = countTokens(decoderPrompt, enc);
+  if (M >= identity.messageTokens) {                                       // G3
+    return { ...identity, notes: `identity: keyed arm ${M} >= identity ${identity.messageTokens}` };
+  }
+  return {
+    codec: 'onomasia', arm: 'keyed', wire: d.wire, decoded: text, exact: true, marks, inTokens,
+    messageTokens: M, daedalus: d, decoderPrompt,
+    notes: `marks=${marks}; keyed M=${M} vs identity ${identity.messageTokens}`,
+  };
+}
+
+/** Arm-aware library reader. The keyed arm is DAEDALUS expansion then the keyed rule; identity is DAEDALUS alone. */
+export function onomasiaDecode(wire: string, arm: 'keyed' | 'identity' = 'keyed'): string {
+  const expanded = daedalusDecode(wire);
+  return arm === 'keyed' ? onomasiaExpand(expanded) : expanded;
+}
