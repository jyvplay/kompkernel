--- /dev/null
+++ b/bench/z51/den-unit.ts
@@ -0,0 +1,26 @@
+import { denTree, denExpand, denLines } from '@/lib/omega/dendron';
+const cases: string[][] = [
+  ['a/b', 'a/c', 'a/d'],
+  ['dir/', 'dir/x', 'dir/y'],
+  ['a/b', 'a/b/c', 'a/b/d', 'a/e'],
+  ['./src/a/x.ts', './src/a/y.ts', './src/b/z.ts'],
+  ['/usr/bin/a', '/usr/bin/b', '/usr/lib/c', '/usr/lib/d/e', '/usr/lib/d/f'],
+  ['a/x/1', 'a/x/2', 'a/y/1', 'a/y/2', 'a/y/3'],
+  ['p/q', 'p/q', 'p/r'],
+  ['noslash', 'a/1', 'a/2'],
+  ['ünï/cödé/α', 'ünï/cödé/β', 'ünï/ß'],
+];
+let ok = 0;
+for (const c of cases) {
+  const t = denTree(c).join('\n');
+  const back = denExpand(t);
+  const pass = back === c.join('\n');
+  if (pass) ok++;
+  console.log(pass ? 'OK  ' : 'FAIL', JSON.stringify(t), pass ? '' : JSON.stringify(back));
+}
+console.log(`${ok}/${cases.length} exact`);
+console.log('denLines refuses:', denLines('a/b\na/c\n'), denLines('a/{b}\nx/c\ny/d'), denLines('a b/c\nd/e\nf/g'), denLines('a/b\n\nc/d'));
+for (const c of [['a/b','a/c','a/d',''], ['a/b','','c/d','e/f'], ['x/','x/y','x/z','']]) {
+  const t = denTree(c).join('\n'); console.log(denExpand(t) === c.join('\n') ? 'OK  ' : 'FAIL', JSON.stringify(t));
+}
+console.log('trailing-newline lines accepted:', denLines('a/b\na/c\na/d\n') !== null);
diff --git a/bench/z51/hunk-mass.ts b/bench/z51/hunk-mass.ts
new file mode 100644
index 0000000..50b90fb
--- /dev/null
+++ b/bench/z51/hunk-mass.ts
@@ -0,0 +1,14 @@
+import fs from 'node:fs';
+import { countTokens } from '@/lib/omega/bpe';
+const enc = 'o200k_base' as const;
+for (const f of process.argv.slice(2)) {
+  const text = fs.readFileSync(f, 'utf8');
+  const lines = text.split('\n');
+  const hdr = lines.filter(l => /^@@ -\d+(,\d+)? \+\d+(,\d+)? @@/.test(l));
+  const hdrTok = countTokens(hdr.join('\n'), enc);
+  const total = countTokens(text, enc);
+  // derivable parts: the ",count" of old and new side (the start of new side is derivable from cumulative delta)
+  const counts = hdr.map(l => l.match(/^@@ -\d+(,\d+)? \+\d+(,\d+)? @@/)![0]);
+  const cntOnly = countTokens(hdr.map(h => h.replace(/^@@ -(\d+)(,\d+)? \+(\d+)(,\d+)? @@.*/, (_m, a, b, c, d) => `${b ?? ''}${d ?? ''}`)).join('\n'), enc);
+  console.log(JSON.stringify({ f, total, hunks: hdr.length, hdrTok, hdrShare: +(100 * hdrTok / total).toFixed(2), countTok: cntOnly, countShare: +(100 * cntOnly / total).toFixed(2) }));
+}
diff --git a/bench/z51/lanes.ts b/bench/z51/lanes.ts
new file mode 100644
index 0000000..9a0bc77
--- /dev/null
+++ b/bench/z51/lanes.ts
@@ -0,0 +1,16 @@
+// z51 harness: frontier (DAEDALUS, PARADEIGMA) on every prose/ops/holdout lane, split into contract vs wire.
+// usage: OMEGA_DET=1 bench/tmp/run.sh bench/z51/lanes.ts <file> ...
+import fs from 'node:fs';
+import { daedalusEncode } from '@/lib/omega/daedalus';
+import { countTokens } from '@/lib/omega/bpe';
+const enc = 'o200k_base' as const;
+for (const f of process.argv.slice(2)) {
+  const text = fs.readFileSync(f, 'utf8');
+  const t0 = Date.now();
+  const d = daedalusEncode(text, enc, {});
+  const row = {
+    file: f, raw: d.inTokens, M: d.messageTokens, wire: d.outTokens, contract: d.contractTokens,
+    exact: d.exact && d.decoded === text, arm: d.winningArm, ms: Date.now() - t0,
+  };
+  console.log(JSON.stringify(row));
+}
