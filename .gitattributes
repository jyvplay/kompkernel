bench/x161/fixtures/*.txt -text whitespace=-blank-at-eof,-blank-at-eol
bench/x161/fixtures/*.diff -text whitespace=-blank-at-eof,-blank-at-eol
bench/x161/receipts/native-*.txt -text whitespace=-blank-at-eof,-blank-at-eol

# Preserve the extracted upstream notebook cell-source text verbatim.
bench/x161/research/google-capsets.txt -text whitespace=-blank-at-eol

