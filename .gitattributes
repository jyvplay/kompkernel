bench/x159/receipts/native-packet.txt -text whitespace=-blank-at-eof
# X160 byte-exact source fixtures, including Git context whitespace.
bench/x160/fixtures/*.diff -text whitespace=-blank-at-eof,-blank-at-eol
bench/x160/fixtures/*.txt -text whitespace=-blank-at-eof,-blank-at-eol
bench/x160/receipts/native-packet.txt -text whitespace=-blank-at-eof,-blank-at-eol
