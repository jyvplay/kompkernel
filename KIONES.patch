+  if(typeof r.wire==='string'&&r.wire.startsWith(CHIRON_START)){try{if(chironDecode(r.wire)===t) v=Math.min(v,T(r.wire)+T(syntomiaContract(r.wire,t)));}catch{}} return v;};
