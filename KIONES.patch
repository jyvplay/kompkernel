+  for(let i=0;i<n;i++)rk[a[i]]=i;
+  for(let i=0;i<n;i++){if(rk[i]>0){const j=a[rk[i]-1];while(i+h<n&&j+h<n&&s[i+h]===s[j+h])h++;L[rk[i]]=h;if(h>0)h--;}else h=0;}
+  return L;}
