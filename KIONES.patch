+import fs from 'node:fs'; import path from 'node:path';
+import { countTokens, type EncodingName } from '../src/lib/omega/bpe';
+import { anastropheGate, anastropheEncode, longestDuplicateRun } from '../src/lib/omega/anastrophe';
