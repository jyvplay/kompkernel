+  const cost=(tp:string,bd:string)=>{const w=CHIRON_START+tp+CHIRON_SEP+bd;
+    if(chironDecode(w)!==src) return {t:Infinity,w}; return {t:T(w)+T(syntomiaContract(w,src)),w};};
