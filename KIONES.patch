+    const rx=x+k<n?r[x+k]:-1,ry=y+k<n?r[y+k]:-1;return rx-ry;};a.sort(c);t[a[0]]=0;
+    for(let i=1;i<n;i++)t[a[i]]=t[a[i-1]]+(c(a[i-1],a[i])<0?1:0);r.set(t);if(r[a[n-1]]===n-1)break;}
